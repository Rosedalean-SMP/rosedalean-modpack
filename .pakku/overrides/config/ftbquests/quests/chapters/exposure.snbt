		{
			dependencies: ["21A7C816958D44B1"]
			description: [
				"The Album provides an in-game scrapbook for collecting and organizing your photographs. Unlike loose photos scattered in chests, Albums keep your images together in a browseable format that other players can view."
				""
				"The Album opens a custom interface where you can insert photographs, add written notes and captions, and organize pages. Right-click while holding an Album to browse its contents."
				""
				"{@pagebreak}"
				"Albums can be signed like written books, locking their contents and adding an enchantment glint to the item. Signed Albums become permanent records that cannot be modified, making them perfect for completed photo journals or gifts to other players."
				""
				"Place an Album on a Lectern to create a public viewing station where other players can flip through your photographs. This works identically to placing a signed book, allowing anyone nearby to enjoy your captured memories."
			]
			id: "10A1DEE7158B9E2C"
			rewards: [{
				id: "73583DD088CA7643"
				type: "xp"
				xp: 100
			}]
			tasks: [{
				id: "180CC8C1335CD8B4"
				item: "exposure:album"
				type: "item"
			}]
			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["21A7C816958D44B1"]
			description: [
				"The Photograph Frame is a dedicated display block designed specifically for Exposure photos. Craft it using an Item Frame surrounded by Sticks and Wooden Planks. Place the frame on any wall, then right-click with a photograph to display it."
				""
				"Photograph Frames can also be placed on floors and ceilings, and come in three sizes: 1x1, 2x2, and 3x3. Apply a Glow Ink Sac to make the frame glow in the dark."
			]
