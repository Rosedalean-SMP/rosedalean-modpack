			}]
			x: 0.5d
			y: -3.0d
		}
		{
			dependencies: ["1930CF6C6F3F3E28"]
			description: ["Both Black and White and Color Film have High Sensitivity variants. These specialized films perform better in low-light conditions, reducing grain and noise in darker environments. High Sensitivity films are ideal for cave photography, nighttime shots, or capturing scenes in the Nether and End dimensions where lighting is limited."]
			id: "46EEDE8CB97A1332"
